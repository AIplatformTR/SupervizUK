rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Confidential case attachments scoped strictly by organisation
    match /organisations/{orgId}/cases/{caseId}/{fileName} {
      allow read, write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
